# Copy to .env (git-ignored). Real values come from the Daikin SkyportHome app.
DAIKIN_API_KEY=your-integrator-api-key
DAIKIN_INTEGRATOR_TOKEN=your-integrator-token
DAIKIN_EMAIL=account-email@example.com
DB_DSN=postgresql://climate:climate@db:5432/climate

# The LAN interface the dashboard binds to. NO auth. Left commented so an
# unedited copy binds to loopback (127.0.0.1) — the fail-closed default in
# docker-compose.yml, reachable only from the server itself. Uncomment and set
# it to your server's LAN IP to actually serve the wall display to the LAN.
# CLIMATE_BIND=192.168.1.50

# Host allowlist (DNS-rebinding defense). By default the dashboard accepts
# requests whose Host is an IP literal, localhost, a dotless LAN name
# (climate:8090), or a *.local name. If you reach it by a public-looking
# multi-label hostname (e.g. climate.example.com), list it here (comma-
# separated) or requests get a 400. Reads/writes are otherwise open on the LAN.
# CLIMATE_ALLOWED_HOSTS=climate.example.com

# Per-IP limit on write requests per minute (default 60). Writes are the
# unauthenticated HA-push / intervention / filter-change endpoints.
# CLIMATE_WRITE_RATE_PER_MIN=60

# Backup-staleness threshold for the dashboard header badge (seconds, default
# 108000 = 30h). The badge appears once the last successful backup is older
# than this — 30h clears the nightly run plus its randomized delay, so only a
# genuinely missed/failed backup trips it. Raise it if you back up less often.
# HC_BACKUP_STALE_SECS=108000
